# commercetools project credentials (server-side only — never expose to the browser)
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_SCOPES=view_products view_categories view_published_products view_product_selections view_standalone_prices view_discount_codes view_cart_discounts view_shipping_methods view_types manage_types view_tax_categories view_business_units view_quote_requests view_quotes view_approval_rules manage_approval_rules view_approval_flows manage_approval_flows manage_products manage_orders manage_customers manage_shopping_lists manage_order_edits manage_sessions create_anonymous_token
CRON_SECRET=replace-with-a-long-random-secret

# commercetools Checkout — key of the Checkout Application configured in Merchant Center
# (Settings > Checkout > Applications).
CTP_CHECKOUT_APP_KEY=storefront-checkout

# Session cookie signing secret (jose). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-byte-hex-string

# Default currency shown in prices when not tied to a specific locale.
DEFAULT_CURRENCY=USD
